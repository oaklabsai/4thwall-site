{
  "github": {
    "autoAlias": true,
    "productionBranch": "main"
  },
  "functions": {
    "api/triage.mjs": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/atlas",         "destination": "/atlas.html" },
    { "source": "/lens",          "destination": "/lens.html" },
    { "source": "/workspace",     "destination": "/workspace.html" },
    { "source": "/workspace/signin", "destination": "/workspace-signin.html" },
    { "source": "/workspace/onboarding", "destination": "/workspace-onboarding.html" },
    { "source": "/missed-calls",  "destination": "/missed-calls.html" },
    { "source": "/es",            "destination": "/missed-calls-es.html" },
    { "source": "/vesta",         "destination": "/vesta-app.html" },
    { "source": "/vesta/search",  "destination": "/vesta.html" },
    { "source": "/find",          "destination": "/find.html" },
    { "source": "/address",       "destination": "/address.html" },
    { "source": "/myhome",        "destination": "/myhome.html" },
    { "source": "/signin",        "destination": "/signin.html" },
    { "source": "/request",       "destination": "/request.html" },
    { "source": "/opt-out",       "destination": "/opt-out.html" },
    { "source": "/privacy",       "destination": "/privacy.html" },
    { "source": "/terms",         "destination": "/terms.html" },
    { "source": "/auth/confirm",  "destination": "/auth-confirm.html" },
    { "source": "/auth/workspace", "destination": "/workspace-auth-callback.html" },
    { "source": "/record/:token", "destination": "/record.html" },
    { "source": "/pro/:id",       "destination": "/pro.html" },
    { "source": "/c/:placeId",    "destination": "/api/contractor?placeId=:placeId" },
    { "source": "/fairfield-county/:trade", "destination": "/api/directory?trade=:trade" },
    { "source": "/directory",     "destination": "/api/hub" },
    { "source": "/fairfield-county-contractor-report", "destination": "/api/report" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" }
  ],
  "redirects": [
    { "source": "/trades.html",           "destination": "/atlas",                              "permanent": true },
    { "source": "/trades",                "destination": "/atlas",                              "permanent": true },
    { "source": "/ops.html",              "destination": "/atlas",                              "permanent": true },
    { "source": "/ops",                   "destination": "/atlas",                              "permanent": true },
    { "source": "/aga-case-study.html",   "destination": "/case-study-wealth-management.html", "permanent": true },
    { "source": "/bluecrest-am.html",     "destination": "/case-study-amenity-management.html", "permanent": true },
    { "source": "/honey-due.html",        "destination": "/case-study-home-services.html",      "permanent": true },
    { "source": "/vesta-app",             "destination": "/vesta",                              "permanent": true },
    { "source": "/vesta-app.html",        "destination": "/vesta",                              "permanent": true },
    { "source": "/login.html",            "destination": "/",                                   "permanent": true },
    { "source": "/dashboard.html",        "destination": "/",                                   "permanent": true },
    { "source": "/admin.html",            "destination": "/",                                   "permanent": true },
    { "source": "/portal/(.*)",           "destination": "/",                                   "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",    "value": "nosniff" },
        { "key": "X-Frame-Options",           "value": "DENY" },
        { "key": "Referrer-Policy",           "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",        "value": "geolocation=(), microphone=(), camera=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/case-study-(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, nosnippet, noarchive" }
      ]
    },
    {
      "source": "/(close|onboard|directory).html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, nosnippet, noarchive" }
      ]
    },
    {
      "source": "/record/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, nosnippet, noarchive" }
      ]
    },
    {
      "source": "/pro/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/myhome",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/vesta/search",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/auth/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, nosnippet, noarchive" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://vinytnzzgryodyrftabg.supabase.co; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'" }
      ]
    },
    {
      "source": "/workspace(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, nosnippet, noarchive" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://vinytnzzgryodyrftabg.supabase.co; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'" }
      ]
    },
    {
      "source": "/lens",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://vinytnzzgryodyrftabg.supabase.co; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'" }
      ]
    }
  ]
}
