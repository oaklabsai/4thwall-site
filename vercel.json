{
  "github": {
    "autoAlias": true,
    "productionBranch": "main"
  },
  "redirects": [
    { "source": "/aga-case-study.html",   "destination": "/case-study-wealth-management.html", "permanent": true },
    { "source": "/bluecrest-am.html",     "destination": "/case-study-amenity-management.html", "permanent": true },
    { "source": "/honey-due.html",        "destination": "/case-study-home-services.html",      "permanent": true },
    { "source": "/login.html",            "destination": "/",                                   "permanent": true },
    { "source": "/dashboard.html",        "destination": "/",                                   "permanent": true },
    { "source": "/admin.html",            "destination": "/",                                   "permanent": true },
    { "source": "/portal/(.*)",           "destination": "/",                                   "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",    "value": "nosniff" },
        { "key": "X-Frame-Options",           "value": "DENY" },
        { "key": "Referrer-Policy",           "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",        "value": "geolocation=(), microphone=(), camera=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/case-study-(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, nosnippet, noarchive" }
      ]
    }
  ]
}
